# ClinicPro - Variables de Entorno

# ==========================================
# IMPORTANTE: URL del Backend API
# ==========================================
# Opción 1: Backend local (para desarrollo)
# VITE_API_URL=http://localhost:3001/api
#
# Opción 2: Backend en Render (producción)
# Reemplaza con tu URL de Render después de desplegar
# VITE_API_URL=https://clinicpro-api.onrender.com/api
#
# Por defecto usa local:
VITE_API_URL=http://localhost:3001/api

# ==========================================
# Configuración de EmailJS (Opcional)
# ==========================================
# Regístrate en https://www.emailjs.com/
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# ==========================================
# Otras configuraciones
# ==========================================
VITE_APP_NAME=ClinicPro
